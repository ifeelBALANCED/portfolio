{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm knip && pnpm test && pnpm build && pnpm test:e2e",
    "ledger:refresh": "node scripts/refresh-ledger.ts",
    "knip": "knip",
    "ub:crap": "${UB_TOOLS:-$HOME/tools/ub}/crapper/crapper src scripts",
    "ub:dry": "${UB_TOOLS:-$HOME/tools/ub}/dryer/dryer src scripts",
    "ub:mutate": "${UB_TOOLS:-$HOME/tools/ub}/mutator/mutator src/domain scripts/github.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "knip": "^6.43.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.28.6"
}
