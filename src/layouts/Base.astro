---
import '../styles/global.css';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import onestCyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import monoCyrillic from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-cyrillic-wght-normal.woff2?url';
import { profile } from '../data/profile';
import { LOCALES, alternates, localizedPath, type Locale } from '../domain/locale';
import { THEMES, themeCss } from '../domain/themes';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  noindex?: boolean;
}

const { locale, title = t(locale).meta.title, noindex = false } = Astro.props;
const copy = t(locale);
const origin = Astro.site?.origin ?? '';
const url = new URL(localizedPath(locale), Astro.site);
const image = new URL(copy.meta.ogImage, Astro.site);
const fonts = locale === 'uk' ? [onestLatin, onestCyrillic, monoLatin, monoCyrillic] : [onestLatin, monoLatin];
const known = JSON.stringify(THEMES.map((theme) => theme.id));
const themeScript = `var t=null;try{t=localStorage.getItem('vh-theme')}catch(e){}if(${known}.indexOf(t)<0)t=matchMedia('(prefers-color-scheme:dark)').matches?'graphite':'paper';document.documentElement.dataset.theme=t`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={copy.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={url} />}
    {!noindex && alternates(origin).map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101214" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={copy.meta.ogLocale} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={t(l).meta.ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    {fonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <style is:inline set:html={themeCss(THEMES)}></style>
    <script is:inline set:html={themeScript}></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name.en,
      jobTitle: t('en').hero.headingLead + t('en').hero.headingTail,
      url: Astro.site,
      sameAs: [profile.github, profile.linkedin],
      address: { '@type': 'PostalAddress', addressLocality: 'Kyiv', addressCountry: 'UA' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">{copy.skip}</a>
    <slot />
  </body>
</html>
