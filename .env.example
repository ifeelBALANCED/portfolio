# Copy to .env.local (git-ignored). Every variable is optional; the site builds with none set.
# Read only through src/domain/env.ts, never process.env directly.

# Origin used for canonical links, hreflang, sitemap host and the share image. https, no path.
SITE_URL=https://vladyslav-herasymenko.vercel.app

# Raises the GitHub API rate limit for `pnpm ledger:refresh`. Public data: no scopes needed.
# Local: GITHUB_TOKEN=$(gh auth token) pnpm ledger:refresh. CI: secrets.LEDGER_TOKEN or the built-in token.
GITHUB_TOKEN=

# Point Playwright at a deployed site instead of the local preview.
BASE_URL=
